<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>title</key><string>Fake Dynamic Island</string>
  <key>defaults</key><string>com.you.fakedi</string>
  <key>items</key>
  <array>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>General</string>
      <key>footerText</key><string>Overlay-only fake Dynamic Island for iPhone 6s / iOS 15. Does NOT modify system files or MobileGestalt, so it cannot white-apple. Respring (or toggle Enable off/on) to apply appearance changes.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Enable</string>
      <key>key</key><string>Enabled</string>
      <key>default</key><true/>
      <key>PostNotification</key><string>com.you.fakedi/ReloadPrefs</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</string>
      <key>label</key><string>Appearance</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>label</key><string>Pill Width</string>
      <key>key</key><string>PillWidth</string>
      <key>default</key><real>120</real>
      <key>min</key><real>60</real>
      <key>max</key><real>340</real>
      <key>PostNotification</key><string>com.you.fakedi/ReloadPrefs</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>label</key><string>Pill Height</string>
      <key>key</key><string>PillHeight</string>
      <key>default</key><real>34</real>
      <key>min</key><real>18</real>
      <key>max</key><real>120</real>
      <key>PostNotification</key><string>com.you.fakedi/ReloadPrefs</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>label</key><string>Corner Radius</string>
      <key>key</key><string>PillCornerRadius</string>
      <key>default</key><real>17</real>
      <key>min</key><real>0</real>
      <key>max</key><real>60</real>
      <key>PostNotification</key><string>com.you.fakedi/ReloadPrefs</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSliderCell</string>
      <key>label</key><string>Top Offset</string>
      <key>key</key><string>PillYOffset</string>
      <key>default</key><real>8</real>
      <key>min</key><real>0</real>
      <key>max</key><real>80</real>
      <key>PostNotification</key><string>com.you.fakedi/ReloadPrefs</string>
    </dict>
    <dict>
      <key>cell</key><string>PSGroupCell</key>
      <key>label</key><string>Activities</string>
      <key>footerText</key><string>Choose which events animate the island.</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Now Playing</string>
      <key>key</key><string>ShowNowPlaying</string>
      <key>default</key><true/>
      <key>PostNotification</key><string>com.you.fakedi/ReloadPrefs</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Charging</string>
      <key>key</key><string>ShowCharging</string>
      <key>default</key><true/>
      <key>PostNotification</key><string>com.you.fakedi/ReloadPrefs</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>App Launch</string>
      <key>key</key><string>ShowAppLaunch</string>
      <key>default</key><true/>
      <key>PostNotification</key><string>com.you.fakedi/ReloadPrefs</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Low Power Mode</string>
      <key>key</key><string>ShowLowPower</string>
      <key>default</key><true/>
      <key>PostNotification</key><string>com.you.fakedi/ReloadPrefs</string>
    </dict>
    <dict>
      <key>cell</key><string>PSSwitchCell</string>
      <key>label</key><string>Animations</string>
      <key>key</key><string>Animate</string>
      <key>default</key><true/>
      <key>PostNotification</key><string>com.you.fakedi/ReloadPrefs</string>
    </dict>
  </array>
</dict>
</plist>
